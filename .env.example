# Copy to .env.local for local development. Never commit real values.
# Server-side only. Do NOT prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Model id your key can actually call (default: gemini-3.1-flash-lite). List yours with:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" "https://generativelanguage.googleapis.com/v1beta/models"
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional tuning
CHAT_MAX_OUTPUT_TOKENS=600
CHAT_RATE_LIMIT_PER_MIN=5
CHAT_RATE_LIMIT_PER_HOUR=30
CHAT_DAILY_LIMIT=300
CHAT_HASH_SALT=change-me
# Comma-separated extra origins allowed to call /api/chat (same-origin always works)
ALLOWED_ORIGINS=

# Optional durable rate limiting (Upstash Redis REST, free tier). Without these, limits are per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
